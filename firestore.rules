rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Globals & Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isVerified() && getUserRole() == 'admin'; }
    function isTech() { return isVerified() && getUserRole() == 'tech'; }
    function isCashier() { return isVerified() && getUserRole() == 'cashier'; }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Collections

    // Users
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'name', 'role', 'createdAt']) && 
               data.keys().size() == 5 &&
               data.uid == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['admin', 'tech', 'cashier', 'staff'] &&
               data.createdAt == request.time;
      }
      
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isVerified() && userId == request.auth.uid && isValidUser(incoming()) && incoming().role == 'staff'; // Default role
      allow update: if isVerified() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name'])) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']))
      );
    }

    // Inventory
    match /inventory/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'category', 'quantity', 'price', 'cost', 'minQuantity', 'updatedAt']) &&
               data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
               data.category is string &&
               data.quantity is number &&
               data.price is number && data.price >= 0 &&
               data.updatedAt == request.time;
      }

      allow read: if isVerified();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isVerified() && (
        isAdmin() || 
        (isCashier() && incoming().diff(existing()).affectedKeys().hasOnly(['quantity'])) ||
        (isTech() && incoming().diff(existing()).affectedKeys().hasOnly(['quantity']))
      );
    }

    // Sales
    match /sales/{saleId} {
      function isValidSale(data) {
        return data.keys().hasAll(['items', 'total', 'paymentMethod', 'date', 'userId', 'profit']) &&
               data.items is list && data.items.size() > 0 &&
               data.total is number && data.total >= 0 &&
               data.userId == request.auth.uid &&
               data.date == request.time;
      }

      allow read: if isAdmin() || isCashier();
      allow create: if (isCashier() || isAdmin()) && isValidId(saleId) && isValidSale(incoming());
    }

    // Customers
    match /customers/{customerId} {
      function isValidCustomer(data) {
        return data.keys().hasAll(['name', 'phone', 'email', 'createdAt']) &&
               data.name is string && data.name.size() > 0 &&
               data.phone is string &&
               data.createdAt == request.time;
      }

      allow read: if isVerified();
      allow create: if isVerified() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isVerified() && incoming().diff(existing()).affectedKeys().hasAny(['name', 'phone', 'email']);
    }

    // Service Orders
    match /serviceOrders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['customerId', 'device', 'status', 'createdAt', 'updatedAt']) &&
               data.status in ['analysis', 'waiting_parts', 'repairing', 'finished', 'delivered'] &&
               data.createdAt == (resource == null ? request.time : existing().createdAt) &&
               data.updatedAt == request.time;
      }

      allow read: if isVerified();
      allow create: if (isTech() || isAdmin() || isCashier()) && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isVerified() && (
        (isAdmin()) ||
        (isTech() && incoming().diff(existing()).affectedKeys().hasAny(['status', 'evaluation', 'technicalReport', 'updatedAt', 'photos'])) ||
        (isCashier() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'total', 'updatedAt']))
      );
    }
  }
}
